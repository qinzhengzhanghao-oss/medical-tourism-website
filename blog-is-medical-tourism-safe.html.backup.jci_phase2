    <!-- 结构化数据 -->
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
            {
                "@type": "Question",
                "name": "Is medical tourism to China safe?",
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "Yes, medical tourism to JCI-accredited Chinese hospitals is as safe as treatment in the US. These hospitals meet identical international standards, use the same equipment, and employ US-trained doctors. The 2026 patient safety data shows a 98.2% success rate and 1.2% complication rate, matching Western standards."
                }
            },
            {
                "@type": "Question",
                "name": "What safety certifications do Chinese hospitals have?",
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "ISO9001 Quality Management System accreditation - the same standard as US hospitals. Additional certifications include ISO medical quality standards and China's Grade 3A hospital classification (highest level)."
                }
            },
            {
                "@type": "Question",
                "name": "What happens if there are complications?",
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "$500,000 medical complication insurance, 24/7 English support, 12-month follow-up care, and emergency transfer protocols to international hospitals if needed."
                }
            }
        ]
    }
    </script>
    
