                        if (entry.target.classList.contains('googleai-section')) {
                            aiInteractions.googleai_signals_viewed = true;
                            console.log('👁️ Google AI signals viewed');
                        }
                    }
                });
            }, { threshold: 0.5 });
            
            // Observe AI sections
            document.querySelectorAll('.ai-section').forEach(section => {
                observer.observe(section);
            });
            
            // Track consultation clicks
            document.querySelector('.whatsapp-btn').addEventListener('click', function() {
                aiInteractions.consultation_clicked = true;
                console.log('📞 Consultation clicked from AI page');
                
