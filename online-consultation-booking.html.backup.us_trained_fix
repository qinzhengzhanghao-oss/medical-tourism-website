    <script>
        // 预约系统交互逻辑
        document.addEventListener('DOMContentLoaded', function() {
            let selectedSpecialty = '';
            let selectedTime = '';
            
            // 步骤1：选择医生
            document.querySelectorAll('.select-doctor-btn').forEach(button => {
                button.addEventListener('click', function() {
                    selectedSpecialty = this.getAttribute('data-specialty');
                    document.getElementById('step1').classList.add('hidden');
                    document.getElementById('step2').classList.remove('hidden');
                });
            });
            
            // 步骤2：选择时间
            document.querySelectorAll('.time-slot').forEach(slot => {
                slot.addEventListener('click', function() {
                    // 移除所有选中状态
                    document.querySelectorAll('.time-slot').forEach(s => {
                        s.classList.remove('selected');
                    });
                    // 添加当前选中状态
                    this.classList.add('selected');
                    selectedTime = this.getAttribute('data-time');
                    
                    // 更新预约摘要
                    let specialtyText = '';
                    switch(selectedSpecialty) {
                        case 'dental': specialtyText = 'Dental Implants Consultation'; break;
                        case 'cosmetic': specialtyText = 'Cosmetic Surgery Consultation'; break;
                        case 'health': specialtyText = 'Health Screening Consultation'; break;
                    }
                    document.getElementById('appointmentSummary').textContent = 
                        `${specialtyText} - Time: ${selectedTime}`;
                });
            });
            
            // 返回步骤1
            document.getElementById('backToStep1').addEventListener('click', function() {
                document.getElementById('step2').classList.add('hidden');
                document.getElementById('step1').classList.remove('hidden');
            });
            
            // 前往步骤3
            document.getElementById('proceedToStep3').addEventListener('click', function() {
                if (!selectedTime) {
                    alert('Please select an appointment time');
                    return;
                }
                document.getElementById('step2').classList.add('hidden');
                document.getElementById('step3').classList.remove('hidden');
            });
            
            // 返回步骤2
            document.getElementById('backToStep2').addEventListener('click', function() {
                document.getElementById('step3').classList.add('hidden');
                document.getElementById('step2').classList.remove('hidden');
            });
            
            // 表单提交
            document.getElementById('bookingForm').addEventListener('submit', function(e) {
                e.preventDefault();
                
                // 这里可以添加表单验证和提交逻辑
                // 实际应用中应该发送到后端处理
                
                // 显示成功页面
                document.getElementById('step3').classList.add('hidden');
                document.getElementById('step4').classList.remove('hidden');
                
                // 在实际应用中，这里应该发送数据到服务器
                // 并触发WhatsApp消息发送
            });
        });
    </script>


