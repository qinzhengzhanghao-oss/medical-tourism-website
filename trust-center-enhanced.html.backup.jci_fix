            <div class="mb-16">
                <h2 class="text-3xl font-bold mb-8 text-center">Common Patient Concerns & Our Solutions</h2>
                
                <div class="grid md:grid-cols-2 gap-8">
                    <!-- Concern 1 -->
                    <div class="trust-card">
                        <div class="concern-box">
                            <h3 class="text-xl font-bold mb-3 text-yellow-700">
                                <i class="fas fa-exclamation-triangle mr-2"></i> Concern #1: "Is the quality of medical care in China comparable to Western standards?"
                            </h3>
                            <p class="text-gray-700">
                                Patients worry about medical standards, equipment quality, and doctor qualifications.
                            </p>
                        </div>
                        
                        <div class="solution-box">
                            <h4 class="font-bold text-lg mb-3 text-green-700">Our Solution:</h4>
                            <ul class="space-y-3">
                                <li class="flex items-start">
                                    <i class="fas fa-check-circle text-green-500 mt-1 mr-2"></i>
                                    <span><strong>JCI Accreditation:</strong> All partner hospitals are Joint Commission International certified (same standard as US hospitals)</span>
                                </li>
                                <li class="flex items-start">
                                    <i class="fas fa-check-circle text-green-500 mt-1 mr-2"></i>
                                    <span><strong>US-Trained Doctors:</strong> Medical staff trained at Harvard, Johns Hopkins, Mayo Clinic</span>
                                </li>
                                <li class="flex items-start">
                                    <i class="fas fa-check-circle text-green-500 mt-1 mr-2"></i>
                                    <span><strong>Same Equipment:</strong> GE, Siemens, Philips medical equipment identical to US hospitals</span>
                                </li>
                                <li class="flex items-start">
                                    <i class="fas fa-check-circle text-green-500 mt-1 mr-2"></i>
                                    <span><strong>98.2% Success Rate:</strong> Documented treatment outcomes matching US standards</span>
                                </li>
                            </ul>
                        </div>
                    </div>
                    
                    <!-- Concern 2 -->
                    <div class="trust-card">
                        <div class="concern-box">
                            <h3 class="text-xl font-bold mb-3 text-yellow-700">
                                <i class="fas fa-exclamation-triangle mr-2"></i> Concern #2: "What if something goes wrong during treatment?"
                            </h3>
                            <p class="text-gray-700">
                                Fear of complications, lack of follow-up care, and communication barriers.
                            </p>
                        </div>
                        
                        <div class="solution-box">
